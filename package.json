{
  "name": "cwe-visualizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A visual explorer for the full CWE (Common Weakness Enumeration) corpus.",
  "author": "Allon Mureinik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mureinik/cwe-visualizer.git"
  },
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:css": "stylelint \"**/*.css\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:realworld": "vitest run --tags-filter='!theoretical'",
    "prepare": "husky",
    "prepare-data": "node scripts/prepare-data.ts",
    "predev": "npm run prepare-data",
    "prebuild": "npm run prepare-data",
    "build:site": "tsc --noEmit && node scripts/build-site.ts",
    "prebuild:site": "npm run prepare-data"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.67.0",
    "@html-eslint/parser": "^0.67.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-config": "^5.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/escape-html": "^1.0.4",
    "@types/node": "24.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "adm-zip": "^0.6.1",
    "escape-html": "^1.0.3",
    "eslint": "^10.13.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-yml": "^3.9.0",
    "fast-xml-parser": "^5.11.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "stylelint": "^17.16.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,yml,yaml,html}": "eslint --fix --max-warnings 0 --no-warn-ignored",
    "*.css": "stylelint --fix",
    "*.md": "markdownlint-cli2 --fix"
  }
}
