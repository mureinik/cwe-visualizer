        <Technology Class="Mobile" Prevalence="Undetermined"/>
      </Applicable_Platforms>
      <Technical_Nuance>
        <xhtml:p>Targets include:</xhtml:p>
        <xhtml:ul>
          <xhtml:li>stored input</xhtml:li>
          <xhtml:li>reflected input</xhtml:li>
        </xhtml:ul>
      </Technical_Nuance>
      <Modes_Of_Introduction>
        <Introduction>
          <Phase>Implementation</Phase>
        </Introduction>
        <Introduction>
          <Phase>Architecture and Design</Phase>
        </Introduction>
      </Modes_Of_Introduction>
